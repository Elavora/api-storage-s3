{
  "name": "elavora/api-storage-s3",
  "description": "Armazenamento S3 opcional para o framework Elavora",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "aws/aws-sdk-php": "^3.381",
    "elavora/api-framework": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Elavora\\Api\\Extension\\StorageS3\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "lint": "@php tools/lint.php",
    "test": "@php vendor/bin/phpunit -c phpunit.xml",
    "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
